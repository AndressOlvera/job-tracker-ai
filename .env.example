# Valores de desarrollo local; ninguno es un secreto real.
# Copia este archivo a .env para cambiarlos. Docker Compose funciona sin .env.

# ---------- Base de datos (servicio db de docker-compose.yml) ----------
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker
POSTGRES_PORT=5432

# ---------- Backend ----------
APP_ENV=development
FLASK_APP=app:create_app
FLASK_DEBUG=1
DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker@localhost:5432/jobtracker
TEST_DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker@localhost:5432/jobtracker_test
APP_TIMEZONE=America/Mexico_City
